{"hash":"LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk","cache_type":"Pure","defs":{"readme_dm_by_month":{"function":["def readme_dm_by_month():\n    \"\"\"Live count of this blog's posts by month, from the post frontmatter dates\n    (the source-of-truth the RSS feed publishes). Seeds a single post if run\n    outside the repo so the launch cell always shows.\"\"\"\n    import glob, pathlib, re\n    counts: dict = {}\n    for p in glob.glob(\"docs/posts/*.md\"):\n        m = re.search(r\"^date:\\s*(\\d{4}-\\d{2})\",\n                      pathlib.Path(p).read_text(encoding=\"utf-8\"), re.M)\n        if m:\n            counts[m.group(1)] = counts.get(m.group(1), 0) + 1\n    return counts or {\"2026-06\": 1}\n","/tmp/marimo_2445/__marimo__cell_MJUe_.py",21,false]},"chart":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk/chart.pickle","hash":"","type_hint":"altair.vegalite.v6.api.LayerChart"},"ax_year":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk/ax_year.pickle","hash":"","type_hint":"altair.vegalite.v6.schema.channels.X"},"y":{"primitive":2026},"quarters":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk/quarters.pickle","hash":"68151f9db6228b7c9360aab4819502d21f3b56cebe3f005e9ecb00a01c38f387","type_hint":"builtins.list"},"alt":{"module":"altair","module_version":"6.2.1"},"key":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk/key.pickle","hash":"","type_hint":"builtins.tuple"},"tag":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk/tag.pickle","hash":"","type_hint":"altair.vegalite.v6.api.Chart"},"ring":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk/ring.pickle","hash":"","type_hint":"altair.vegalite.v6.api.Chart"},"m":{"primitive":8},"ax_q":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCXvvehFYbk/ax_q.pickle","hash":"","type_hint":"altair.vegalite.v6.schema.channels.Y"},"df":{"reference":"cell_cache/LrmYGXHsxZSAWnjhtXQUkNBX3IrCqOMYFCX